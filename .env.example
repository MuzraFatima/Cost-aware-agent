# ─────────────────────────────────────────────────────────────────────────────
# Cost-Aware Agent Router — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in at least one real provider API key.
# Without a real key the system runs in Sandbox / Mock mode (no LLM calls).
#
# Usage (bash / macOS / Linux):
#   cp .env.example .env
#   # edit .env with your keys
#   uvicorn backend.app.main:app --reload
#
# Usage (PowerShell / Windows):
#   Copy-Item .env.example .env
#   # edit .env with your keys
#   python -m uvicorn backend.app.main:app --reload
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider Keys ─────────────────────────────────────────────────────────
# Set at least ONE real key to enable live LLM calls.
# Any key left at its placeholder value keeps that provider in mock mode.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...
GROQ_API_KEY=gsk_...


# ── Model per Tier (optional — shown values are the code defaults) ─────────────
# Tier 1  Fast / cheap (small model):  handles simple queries
# Tier 2  RAG-augmented (small model): adds knowledge-base context
# Tier 3  Large model single-shot:     high-precision responses
# Tier 4  Large model consensus loop:  multi-agent cross-verification
#
# Default provider: Groq API (https://console.groq.com)
# gpt-oss-20b  = 20B-parameter open-source model via Groq  (small model)
# gpt-oss-120b = 120B-parameter open-source model via Groq (large model)

TIER_1_MODEL=groq/openai/gpt-oss-20b
TIER_2_MODEL=groq/openai/gpt-oss-20b
TIER_3_MODEL=groq/openai/gpt-oss-120b
TIER_4_MODEL=groq/openai/gpt-oss-120b

# ── Alternative provider examples (uncomment and adjust as needed) ────────────
# OpenAI
# TIER_1_MODEL=gpt-4o-mini
# TIER_2_MODEL=gpt-4o-mini
# TIER_3_MODEL=gpt-4o
# TIER_4_MODEL=gpt-4o

# Anthropic
# TIER_3_MODEL=claude-3-5-sonnet-20241022
# TIER_4_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
# TIER_3_MODEL=gemini/gemini-1.5-pro
# TIER_4_MODEL=gemini/gemini-1.5-pro

# ── Database ──────────────────────────────────────────────────────────────────
# Default is SQLite in the project root.  Switch to PostgreSQL for production.
DATABASE_URL=sqlite:///./caar.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/caar
